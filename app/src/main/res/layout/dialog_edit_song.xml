<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/orbitron_bold"
            android:letterSpacing="0.1"
            android:text="EDIT SONG DETAILS"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <!-- Album Art Preview and Change Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivEditAlbumArt"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_note_icon"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnChangeArt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_button_outline_pink"
                android:fontFamily="@font/orbitron_bold"
                android:text="Change Art"
                android:textAllCaps="false"
                android:textColor="@color/neon_pink"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Title"
            app:boxStrokeColor="@color/neon_cyan"
            app:hintTextColor="@color/neon_cyan">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/orbitron_regular"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Artist"
            app:boxStrokeColor="@color/neon_cyan"
            app:hintTextColor="@color/neon_cyan">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/orbitron_regular"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="Album"
            app:boxStrokeColor="@color/neon_cyan"
            app:hintTextColor="@color/neon_cyan">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAlbum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/orbitron_regular"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/orbitron_bold"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_update_song_button"
                android:fontFamily="@font/orbitron_bold"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="@color/bg_primary" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
