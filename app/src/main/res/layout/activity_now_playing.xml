<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:id="@+id/mainContentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_chevron_down"
                android:tint="@color/text_secondary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NOW PLAYING"
                android:textSize="13sp"
                android:letterSpacing="0.16"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center" />

            <ImageButton
                android:id="@+id/btnEqualizer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Equalizer"
                android:src="@drawable/ic_equalizer"
                android:tint="@color/neon_cyan" />

            <ImageButton
                android:id="@+id/btnShuffle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Shuffle"
                android:src="@drawable/ic_shuffle"
                android:tint="@color/text_hint" />

            <ImageButton
                android:id="@+id/btnProfiles"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Profiles"
                android:src="@drawable/ic_layers"
                android:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit Details"
                android:src="@drawable/ic_save"
                android:tint="@color/neon_yellow" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete Song"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="@color/neon_red" />

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_heart_outline"
                android:tint="@color/neon_pink"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Favorite" />

        </LinearLayout>

        <!-- Album art -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp">

            <View
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@drawable/bg_album_disc" />

            <ImageView
                android:id="@+id/ivAlbumArt"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="@drawable/bg_note_icon"
                android:src="@drawable/ic_music_note"
                android:alpha="0.9" />

        </FrameLayout>

        <!-- Song info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="2"
                android:text="Song Title"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/ivManualIndicator"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Manually Edited"
                android:src="@drawable/ic_check"
                android:tint="@color/neon_green"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artist"
            android:textSize="13sp"

            android:textColor="@color/neon_cyan"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:textStyle="bold"
                android:text=""
                android:textColor="@color/neon_yellow"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:alpha="0.8"
                android:textStyle="bold"
                android:text=""
                android:textColor="@color/neon_green"
                android:textSize="10sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="10sp"

            android:textColor="@color/text_hint"
            android:gravity="center"
            android:layout_marginTop="2dp" />

        <!-- Playback seekbar Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPlayback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.mochimochi.clawmikiacrazy.ui.views.SkipRegionsOverlayView
                        android:id="@+id/skipRegionsOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp" />

                    <SeekBar
                        android:id="@+id/seekPlayback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:progressBackgroundTint="@color/seekbar_bg"
                        android:progressTint="@color/neon_pink"
                        android:thumb="@drawable/seekbar_thumb" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="0:00"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="0:00"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Playback controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/btnRepeat"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Repeat"
                    android:src="@drawable/ic_repeat"
                    android:tint="@color/text_hint" />

                <TextView
                    android:id="@+id/tvRepeatIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textStyle="bold"
                    android:text=""
                    android:textColor="@color/neon_purple"
                    android:textSize="10sp" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_skip_prev"
                android:tint="@color/text_secondary"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageButton
                android:id="@+id/btnRewind"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_replay_5"
                android:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:src="@drawable/ic_play"
                android:tint="@color/bg_primary"
                android:background="@drawable/bg_play_button"
                android:contentDescription="Play/Pause" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_forward_5"
                android:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_skip_next"
                android:tint="@color/text_secondary"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/tvRepeatLabel"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text=""
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="@color/neon_cyan"
                android:visibility="invisible" />

        </LinearLayout>

        <!-- Vertical Cards Stack -->
        <include
            android:id="@+id/cardVolume"
            layout="@layout/card_now_playing_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="24dp" />

        <include
            android:id="@+id/cardPitch"
            layout="@layout/card_now_playing_pitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp" />

        <include
            android:id="@+id/cardSpeed"
            layout="@layout/card_now_playing_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp" />

        <include
            android:id="@+id/cardAbRepeat"
            layout="@layout/card_now_playing_ab_repeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp" />

        <include
            android:id="@+id/cardTrim"
            layout="@layout/card_now_playing_trim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp" />

        <include
            android:id="@+id/cardSkipSections"
            layout="@layout/card_now_playing_skip_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp" />

        <include
            android:id="@+id/cardProfiles"
            layout="@layout/card_now_playing_profiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp" />

        <include
            android:id="@+id/cardStateToggle"
            layout="@layout/card_now_playing_state_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp" />

        <!-- RESET ALL STATES BUTTON -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetAllStates"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="@color/neon_red_20"
                android:textStyle="bold"
                android:text="DESTROY ALL STATES / RESET"
                android:textColor="@color/neon_red"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_skull"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconTint="@color/neon_red"
                app:strokeColor="@color/neon_red"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
