<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootBrowse"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_aesthetic"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvBrowseTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:text="BROWSE LIBRARY"
            android:textColor="@color/neon_yellow"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/btnBrowseClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_outline_neutral"
            android:contentDescription="Close"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Mode selector: Folders / Playlists / Albums -->
    <LinearLayout
        android:id="@+id/tabRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_search_field"
        android:padding="4dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tabFolders"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_accordion_tab"
            android:gravity="center"
            android:text="@string/browse_tab_folders"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabPlaylists"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_accordion_tab"
            android:gravity="center"
            android:text="@string/browse_tab_playlists"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabAlbums"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_accordion_tab"
            android:gravity="center"
            android:text="@string/browse_tab_albums"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Subtitle hint -->
    <TextView
        android:id="@+id/tvBrowseHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_hint"
        android:textSize="11sp"
        android:letterSpacing="0.05" />

    <!-- Select all row -->
    <LinearLayout
        android:id="@+id/selectAllRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_field"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/neon_yellow"
            android:clickable="false"
            android:focusable="false" />

        <TextView
            android:id="@+id/tvSelectAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold"
            android:text="@string/browse_select_all"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/neon_yellow"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Scrollable accordion area -->
    <ScrollView
        android:id="@+id/browseScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxHeight="360dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/accordionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:animateLayoutChanges="true" />
    </ScrollView>

    <TextView
        android:id="@+id/tvBrowseEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:textColor="@color/text_hint"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Footer actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnResetBrowse"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_outline_neutral"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/browse_reset"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Footer actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnClearBrowse"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_button_outline_neutral"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/browse_clear"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnApplyBrowse"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_outline_cyan"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/browse_apply"
            android:textStyle="bold"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
