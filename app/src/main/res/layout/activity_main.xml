<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Top app bar pinned, padded for status bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- Title row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_vault_logo"
                    android:tint="@color/neon_pink" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Music Library"
                    android:textSize="15sp"
                    android:letterSpacing="0.12"
                    android:fontFamily="@font/orbitron_bold"
                    android:textColor="@color/text_primary"
                    android:paddingStart="10dp" />

                <!-- Online metadata update button -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <ImageButton
                        android:id="@+id/btnUpdateOnline"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Update metadata online"
                        android:src="@drawable/ic_loop"
                        android:tint="@color/neon_purple" />

                    <TextView
                        android:id="@+id/tvManualCount"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_pitch_badge"
                        android:backgroundTint="@color/neon_green"
                        android:fontFamily="@font/orbitron_bold"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@android:color/black"
                        android:textSize="8sp"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Export library button -->
                <ImageButton
                    android:id="@+id/btnExport"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Export library"
                    android:src="@drawable/ic_save"
                    android:tint="@color/neon_green" />

                <!-- Reset library button (trash icon) -->
                <ImageButton
                    android:id="@+id/btnReset"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Reset library"
                    android:src="@drawable/ic_delete"
                    android:tint="@color/neon_red" />

                <!-- Scan / add folder -->
                <ImageButton
                    android:id="@+id/btnScan"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_folder_add"
                    android:tint="@color/neon_cyan"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Add music folder" />

                <!-- Scan / add specific files -->
                <ImageButton
                    android:id="@+id/btnScanFiles"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Add music files"
                    android:src="@drawable/ic_music_note"
                    android:tint="@color/neon_yellow" />

            </LinearLayout>

            <!-- Search row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_field"
                    app:closeIcon="@drawable/ic_close"
                    app:iconifiedByDefault="false"
                    app:queryHint="Search songs, artists, folders…"
                    app:searchHintIcon="@null"
                    app:searchIcon="@drawable/ic_search" />

                <ImageButton
                    android:id="@+id/btnAdvancedFilter"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_search_field"
                    android:contentDescription="@string/advanced_filters"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_layers"
                    android:tint="@color/neon_orange" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scan progress bar (shown during scanning) -->
    <ProgressBar
        android:id="@+id/scanProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/neon_pink"
        android:visibility="gone"
        app:layout_anchor="@id/appBarLayout"
        app:layout_anchorGravity="bottom" />

    <!-- Content area: fragment + bottom stack, no overlap -->
    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Fragment container fills remaining space -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Mini music panel + bottom nav stacked at bottom -->
        <LinearLayout
            android:id="@+id/bottomArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Mini player -->
            <include
                android:id="@+id/musicPanel"
                layout="@layout/layout_mini_player"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Bottom navigation -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_surface"
                app:itemIconTint="@color/nav_item_color"
                app:itemTextColor="@color/nav_item_color"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav_menu" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
