<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTrim"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="14dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_trim"
                app:tint="@color/text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/orbitron_bold"
                android:letterSpacing="0.14"
                android:paddingStart="8dp"
                android:text="TIMELINE TRIM"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:fontFamily="@font/orbitron_regular"
            android:letterSpacing="0.1"
            android:text="START POINT"
            android:textColor="@color/text_hint"
            android:textSize="9sp" />

        <SeekBar
            android:id="@+id/seekTrimStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressBackgroundTint="@color/seekbar_bg"
            android:progressTint="@color/neon_light_blue"
            android:thumb="@drawable/seekbar_thumb_blue" />

        <TextView
            android:id="@+id/tvTrimStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"
            android:fontFamily="@font/orbitron_regular"
            android:text="Start: 0:00"
            android:textColor="@color/neon_light_blue"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:fontFamily="@font/orbitron_regular"
            android:letterSpacing="0.1"
            android:text="END POINT"
            android:textColor="@color/text_hint"
            android:textSize="9sp" />

        <SeekBar
            android:id="@+id/seekTrimEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressBackgroundTint="@color/seekbar_bg"
            android:progressTint="@color/neon_red"
            android:thumb="@drawable/seekbar_thumb_red" />

        <TextView
            android:id="@+id/tvTrimEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/orbitron_regular"
            android:text="End: 0:00"
            android:textColor="@color/neon_red"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnTrimStartMinus"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_button_outline_blue"
                        android:fontFamily="@font/orbitron_bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="−10s"
                        android:textColor="@color/neon_light_blue"
                        android:textSize="9sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnTrimStartPlus"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_outline_blue"
                        android:fontFamily="@font/orbitron_bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="+10s"
                        android:textColor="@color/neon_light_blue"
                        android:textSize="9sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvTrimStartLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:fontFamily="@font/orbitron_bold"
                        android:gravity="center"
                        android:text="START"
                        android:textColor="@color/neon_light_blue"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnTrimEndMinus"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_button_outline_red"
                        android:fontFamily="@font/orbitron_bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="−10s"
                        android:textColor="@color/neon_red"
                        android:textSize="9sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnTrimEndPlus"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_outline_red"
                        android:fontFamily="@font/orbitron_bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="+10s"
                        android:textColor="@color/neon_red"
                        android:textSize="9sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvTrimEndLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:fontFamily="@font/orbitron_bold"
                        android:gravity="center"
                        android:text="END"
                        android:textColor="@color/neon_red"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTrimReset"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_outline_neutral"
                android:fontFamily="@font/orbitron_bold"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null"
                android:text="Reset Trim"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
