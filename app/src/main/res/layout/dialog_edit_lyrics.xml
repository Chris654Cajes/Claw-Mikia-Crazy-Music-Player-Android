<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Edit Lyrics"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLyrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundColor="@color/bg_card"
            app:boxStrokeColor="@color/neon_orange"
            app:boxStrokeWidth="1dp"
            app:cursorColor="@color/neon_orange"
            app:hintTextColor="@color/text_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="Paste LRC lyrics here (supports [mm:ss.xx] format)\nor plain text lyrics (one line per verse)"
                android:inputType="textMultiLine"
                android:maxLines="12"
                android:minLines="8"
                android:scrollbars="vertical"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnCancel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_outline_neutral"
            android:contentDescription="Cancel"
            android:src="@drawable/ic_close"
            android:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnSavePlain"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_outline_cyan"
            android:contentDescription="Save Plain"
            android:src="@drawable/ic_save"
            android:tint="@color/neon_cyan" />

        <ImageButton
            android:id="@+id/btnSaveLRC"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_outline_orange"
            android:contentDescription="Save LRC"
            android:src="@drawable/ic_check"
            android:tint="@color/neon_orange" />

    </LinearLayout>

</LinearLayout>
