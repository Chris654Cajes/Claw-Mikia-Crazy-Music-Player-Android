<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/viewForeground"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_album_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Expand/collapse chevron -->
        <ImageView
            android:id="@+id/ivChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_secondary" />

        <!-- Album art thumbnail -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/ivAlbumArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_note_icon"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivNoteIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_note_icon"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_music_note"
                app:tint="@color/icon_music" />
        </FrameLayout>

        <!-- Album name -->
        <TextView
            android:id="@+id/tvAlbumName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/orbitron_bold"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- Song count -->
        <TextView
            android:id="@+id/tvSongCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/orbitron_regular"
            android:textColor="@color/text_hint"
            android:textSize="10sp" />

    </LinearLayout>

</FrameLayout>
