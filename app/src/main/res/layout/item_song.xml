<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp">

    <!-- Background (revealed on swipe) -->
    <LinearLayout
        android:id="@+id/viewBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="horizontal" />

    <!-- Foreground (the actual item) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewForeground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/selector_song_item"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <!-- Playing indicator bar on the left edge -->
        <View
            android:id="@+id/ivPlayingIndicator"
            android:layout_width="3dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_playing_bar"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/thumbContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivPlayingIndicator"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivNoteIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_note_icon"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_music_note"
                app:tint="@color/icon_music" />

            <ImageView
                android:id="@+id/ivAlbumArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_note_icon"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:visibility="gone" />

        </FrameLayout>

        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Favorite"
            android:src="@drawable/ic_heart_outline"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:textStyle="bold"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/tvArtist"
            app:layout_constraintEnd_toStartOf="@id/btnFavorite"
            app:layout_constraintStart_toEndOf="@id/thumbContainer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvArtist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="1dp"
            android:ellipsize="end"

            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            app:layout_constraintBottom_toTopOf="@id/badgeRow"
            app:layout_constraintEnd_toStartOf="@id/btnFavorite"
            app:layout_constraintStart_toEndOf="@id/thumbContainer"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <LinearLayout
            android:id="@+id/badgeRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnFavorite"
            app:layout_constraintStart_toEndOf="@id/thumbContainer"
            app:layout_constraintTop_toBottomOf="@id/tvArtist">

            <TextView
                android:id="@+id/tvFolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"

                android:maxWidth="90dp"
                android:maxLines="1"
                android:textColor="@color/neon_cyan"
                android:textSize="9sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:background="@color/divider_color" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:textColor="@color/text_hint"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tvPitchBadge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pitch_badge"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/neon_green"
                android:textSize="8sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivTrimBadge"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_trim"
                android:visibility="gone"
                app:tint="@color/neon_orange" />

            <ImageView
                android:id="@+id/ivSpeedBadge"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_forward_5"
                android:visibility="gone"
                app:tint="@color/neon_orange" />

            <ImageView
                android:id="@+id/ivManualBadge"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/neon_green" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="10dp"
            android:alpha="0.5"
            android:background="@color/divider_color"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/thumbContainer" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
