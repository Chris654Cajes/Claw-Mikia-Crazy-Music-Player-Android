<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:padding="16dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textStyle="bold"
            android:textColor="@color/neon_pink"
            android:textSize="20sp"
            android:layout_marginBottom="24dp" />

        <!-- Favorite Icon Type -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FAVORITE BUTTON UI"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:scrollbars="none">

            <RadioGroup
                android:id="@+id/rgFavoriteIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbHeart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heart"
                    android:textColor="@color/text_secondary"
                    android:paddingEnd="12dp" />

                <RadioButton
                    android:id="@+id/rbSmiley"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smiley"
                    android:textColor="@color/text_secondary"
                    android:paddingEnd="12dp" />

                <RadioButton
                    android:id="@+id/rbStar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Star"
                    android:textColor="@color/text_secondary"
                    android:paddingEnd="12dp" />

                <RadioButton
                    android:id="@+id/rbEye"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eye"
                    android:textColor="@color/text_secondary"
                    android:paddingEnd="12dp" />

                <RadioButton
                    android:id="@+id/rbSun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sun"
                    android:textColor="@color/text_secondary"
                    android:paddingEnd="12dp" />

                <RadioButton
                    android:id="@+id/rbFlower"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flower"
                    android:textColor="@color/text_secondary"
                    android:paddingEnd="12dp" />

                <RadioButton
                    android:id="@+id/rbMoon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moon"
                    android:textColor="@color/text_secondary"
                    android:paddingEnd="12dp" />

                <RadioButton
                    android:id="@+id/rbMusic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Music"
                    android:textColor="@color/text_secondary"
                    android:paddingEnd="12dp" />

                <RadioButton
                    android:id="@+id/rbSparkles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sparkles"
                    android:textColor="@color/text_secondary"
                    android:paddingEnd="12dp" />

                <RadioButton
                    android:id="@+id/rbCloud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cloud"
                    android:textColor="@color/text_secondary"
                    android:paddingEnd="12dp" />
            </RadioGroup>
        </HorizontalScrollView>

        <!-- Now Playing View -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textStyle="bold"
            android:text="NOW PLAYING VIEW STYLE"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:scrollbars="none">

            <RadioGroup
                android:id="@+id/rgNowPlayingView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbStandard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="12dp"
                    android:text="Standard"
                    android:textColor="@color/text_secondary" />

                <RadioButton
                    android:id="@+id/rbCoverFlow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="12dp"
                    android:text="Cover Flow"
                    android:textColor="@color/text_secondary" />

                <RadioButton
                    android:id="@+id/rbRadial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="12dp"
                    android:text="Radial Wheel"
                    android:textColor="@color/text_secondary" />

                <RadioButton
                    android:id="@+id/rbVuMeter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="12dp"
                    android:text="VU Meter"
                    android:textColor="@color/text_secondary" />

                <RadioButton
                    android:id="@+id/rbCircular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="12dp"
                    android:text="Circular"
                    android:textColor="@color/text_secondary" />
            </RadioGroup>
        </HorizontalScrollView>

        <!-- Pitch Step -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PITCH / KEY STEP (1-DIGIT DECIMAL)"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPitchStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="e.g. 0.1"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/neon_purple"
            android:background="@drawable/bg_search_field"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:autofillHints="none" />

        <!-- Playback Speed Step -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PLAYBACK SPEED STEP (INTEGER)"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSpeedStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="e.g. 1"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/neon_green"
            android:background="@drawable/bg_search_field"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:autofillHints="none" />

        <!-- Timeline Trim Step -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIMELINE TRIM STEP (1-DIGIT DECIMAL)"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etTrimStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="e.g. 10.0"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/neon_orange"
            android:layout_marginBottom="24dp"
            android:autofillHints="none"
            android:background="@drawable/bg_search_field"
            android:padding="12dp" />

        <!-- FF / RW Step -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textStyle="bold"
            android:text="FF / RW STEP (SECONDS)"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etSkipStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 5"
            android:inputType="number"
            android:textColor="@color/neon_yellow"
            android:textColorHint="@color/text_hint"
            android:background="@drawable/bg_search_field"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:autofillHints="none" />

        <!-- Sound Environment -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textStyle="bold"
            android:text="SOUND ENVIRONMENT"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerEnvironment"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_search_field"
            android:padding="12dp" />

        <!-- Metadata Update -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textStyle="bold"
            android:text="AUTOMATIC METADATA UPDATE"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateMetadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/neon_cyan_20"
            android:textStyle="bold"
            android:padding="14dp"
            android:text="UPDATE ALL SONGS METADATA"
            android:textColor="@color/neon_cyan" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"

            android:text="Note: Internet connection is required to update album images and details."
            android:textColor="@color/text_hint"
            android:textSize="11sp" />

        <!-- LOCK STATE EDITS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textStyle="bold"
            android:text="SONG STATE EDITING"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_field"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ENABLE UPDATED SONG STATES"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchStatesEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_field"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LOCK ALL SONG STATE EDITS"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchLockEditing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="When enabled, you cannot edit Pitch, Speed, Trim, or Volume states in any song's player view."
            android:textColor="@color/text_hint"
            android:textSize="11sp" />

        <!-- Profile Backup -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textStyle="bold"
            android:text="PROFILE BACKUP"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportProfiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/neon_purple_20"
            android:textStyle="bold"
            android:padding="14dp"
            android:text="EXPORT UPDATED PROFILES"
            android:textColor="@color/neon_purple" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportProfiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/neon_cyan_20"
            android:textStyle="bold"
            android:padding="14dp"
            android:text="IMPORT PROFILES JSON"
            android:textColor="@color/neon_cyan" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"

            android:text="Export a JSON file containing only songs that have their own profiles with updated states. Importing the same file automatically adds / updates those profiles on matching songs."
            android:textColor="@color/text_hint"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings auto-save on change"

            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

        <!-- Reset All Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RESET ALL TO DEFAULT"
            android:textStyle="bold"
            android:textColor="@color/neon_red"
            android:textSize="13sp"
            android:backgroundTint="@color/neon_red_20"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <!-- Spacer to prevent content from being hidden behind mini player/bottom nav -->
        <View
            android:layout_width="match_parent"
            android:layout_height="140dp" />

    </LinearLayout>
</ScrollView>
