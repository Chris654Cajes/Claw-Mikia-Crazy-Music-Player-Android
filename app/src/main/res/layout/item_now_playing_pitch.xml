<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="24dp"
        app:strokeColor="@color/neon_green"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Pitch Icon"
                android:src="@drawable/ic_pitch"
                app:tint="@color/neon_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/orbitron_bold"
                android:text="PITCH / KEY"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekPitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:max="120"
                android:progressTint="@color/neon_green"
                android:thumb="@drawable/seekbar_thumb" />

            <TextView
                android:id="@+id/tvPitchValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/orbitron_bold"
                android:text="0.0"
                android:textColor="@color/neon_green"
                android:textSize="28sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
